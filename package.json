{
  "name": "ven-desktop",
  "version": "0.5.2",
  "description": "VEN para computador (Windows)",
  "main": "main.js",
  "author": "VEN",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "tesseract.js": ">=5.1.0",
    "@tesseract.js-data/por": "*"
  },
  "build": {
    "appId": "br.com.ven.desktop",
    "productName": "VEN",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "servicos.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "artifactName": "VEN-Desktop-${version}-portable.exe"
    }
  }
}